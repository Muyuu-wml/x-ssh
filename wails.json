{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "x-ssh",
  "outputfilename": "x-ssh",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "preBuildHooks": {
    "windows/*": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-icon.ps1"
  },
  "postBuildHooks": {
    "windows/*": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/postbuild.ps1 ${bin}"
  },
  "author": {
    "name": "x-ssh",
    "email": ""
  }
}
